# Server-only secrets: set these in .env.local or Vercel Environment Variables.
# Never prefix AI keys with NEXT_PUBLIC_ or commit real keys.
# Groq is tried first; Gemini and OpenAI are optional fallbacks.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
