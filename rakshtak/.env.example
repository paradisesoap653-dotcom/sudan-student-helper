# ====== المتغيرات الخاصة بمشروع ركشتك — المرحلة 3 ======
# انسخ هذا الملف إلى .env.local وأدخل القيم الحقيقية — لا ترفع .env.local إلى Git أبداً.

# ── بوابة الإدارة (أضِفه في Vercel أيضاً ثم أعد النشر) ──
# أي سلسلة طويلة عشوائية — توليد: openssl rand -hex 24
# بدونه تبقى /admin مقفولة (403) — وضع آمن متعمّد.
RAKSHTAK_ADMIN_TOKEN=

# ── Supabase (قاعدة البيانات الموحّدة — الخادم فقط) ──
NEXT_PUBLIC_SUPABASE_URL=

# مفتاح الخادم (Service Role) — سري جداً: للخادم فقط، لا يصل للمتصفح أبداً.
# بعد المرحلة 3 (تفعيل RLS + منع anon) كل العمليات — الرحلات والسائقين وOTP —
# تمر عبر مسارات الخادم بهذا المفتاح، وتم حذف مفتاح anon من الكود نهائياً.
# من Supabase: Project Settings → API → service_role (نسخته الأصلية فقط — تُعرض مرة واحدة).
SUPABASE_SERVICE_ROLE_KEY=

# ── (اختياري) مزوّد إرسال رمز OTP (SMS/واتساب) ──
# يُستدعى بـ POST JSON { phone, code } — إن تُرك فارغاً:
#   • خارج بيئة الإنتاج (dev/preview) يُعاد الرمز في الاستجابة للتجربة
#   • في الإنتاج تُرفض محاولات الدخول (503) حتى يُضبط المزوّد
RAKSHTAK_OTP_WEBHOOK_URL=
